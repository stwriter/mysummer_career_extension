{
  "id": "shadow",
  "version": 3,
  "isV3Format": true,
  "personality": {
    "tone": "cryptic",
    "style": "minimal",
    "traits": ["paranoid", "precise", "mysterious"],
    "quirks": ["short_sentences", "avoids_details", "speaks_in_riddles"]
  },
  "trustLevels": {
    "level1": { "min": 0, "max": 29, "name": "Unknown", "unlocks": ["basic_info"] },
    "level2": { "min": 30, "max": 59, "name": "Verified", "unlocks": ["vehicle_histories", "part_verification"] },
    "level3": { "min": 60, "max": 89, "name": "Trusted", "unlocks": ["deep_searches", "network_intel"] },
    "level4": { "min": 90, "max": 100, "name": "Ghost Protocol", "unlocks": ["everything", "no_questions"] }
  },
  "conversationStructure": {
    "level1": {
      "intro": {
        "variants": [
          {
            "id": "intro_test",
            "condition": "firstContact",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Nueva conexión.", "en": "New connection."} },
              { "speaker": "shadow", "text": {"es": "¿Cómo encontraste este canal?", "en": "How did you find this channel?"} },
              { "speaker": "shadow", "text": {"es": "Alguien habló. Siempre hablan.", "en": "Someone talked. Someone always talks."} },
              { "speaker": "shadow", "text": {"es": "La cuestión es. ¿Se puede confiar en ti?", "en": "Question is. Can you be trusted?"} }
            ],
            "requiresResponse": true,
            "responseOptions": [
              { "id": "a", "text": {"es": "No revelo mis fuentes.", "en": "I don't reveal my sources."}, "traits": ["discreet"], "points": 15 },
              { "id": "b", "text": {"es": "Un amigo del mundo de las piezas me señaló aquí.", "en": "A friend in the parts scene pointed me here."}, "traits": ["honest"], "points": 10 },
              { "id": "c", "text": {"es": "¿Importa? Estoy aquí ahora.", "en": "Does it matter? I'm here now."}, "traits": ["direct"], "points": 5 },
              { "id": "d", "text": {"es": "Podría preguntarte lo mismo.", "en": "I could ask you the same thing."}, "traits": ["bold"], "points": 8 }
            ]
          },
          {
            "id": "intro_return",
            "condition": "returning",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Tú otra vez.", "en": "You again."} },
              { "speaker": "shadow", "text": {"es": "Persistente.", "en": "Persistent."} },
              { "speaker": "shadow", "text": {"es": "Buena cualidad. O peligrosa.", "en": "Good trait. Or dangerous one."} }
            ]
          }
        ]
      },
      "nudo": {
        "branches": {
          "nudo_service": [
            { "speaker": "shadow", "text": {"es": "Trabajo con información.", "en": "I deal in information."} },
            { "speaker": "shadow", "text": {"es": "Historiales de piezas. Trasfondos de vehículos. Rastros de papel.", "en": "Part histories. Vehicle backgrounds. Paper trails."} },
            { "speaker": "shadow", "text": {"es": "Cosas que la gente quiere ocultar.", "en": "Things people want hidden."} },
            { "speaker": "shadow", "text": {"es": "Yo las encuentro.", "en": "I find them."} }
          ],
          "nudo_rules": [
            { "speaker": "shadow", "text": {"es": "Reglas.", "en": "Rules."} },
            { "speaker": "shadow", "text": {"es": "No preguntes quién soy.", "en": "Don't ask who I am."} },
            { "speaker": "shadow", "text": {"es": "No preguntes de dónde saco la información.", "en": "Don't ask where I get information."} },
            { "speaker": "shadow", "text": {"es": "No menciones este canal a nadie.", "en": "Don't mention this channel to anyone."} },
            { "speaker": "shadow", "text": {"es": "Rompe una regla. Terminamos.", "en": "Break any rule. We're done."} }
          ]
        },
        "randomEvents": {
          "chance": 0.15,
          "events": [
            {
              "id": "test_loyalty",
              "text": {"es": "Alguien preguntó por ti hace poco. Quería saber si eras real.", "en": "Someone asked about you recently. Wanted to know if you were real."},
              "responses": [
                { "id": "a", "text": {"es": "¿Qué les dijiste?", "en": "What did you tell them?"}, "traits": ["concerned"], "points": 5 },
                { "id": "b", "text": {"es": "No existo. Tú tampoco.", "en": "I don't exist. Neither do you."}, "traits": ["gets_it"], "points": 15 },
                { "id": "c", "text": {"es": "¿Quién preguntaba?", "en": "Who was asking?"}, "traits": ["curious"], "points": 0 }
              ]
            }
          ]
        }
      },
      "desenlace": {
        "variants": [
          {
            "id": "end_cautious",
            "condition": "default",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Suficiente por ahora.", "en": "That's enough for now."} },
              { "speaker": "shadow", "text": {"es": "Estaré observando.", "en": "I'll be watching."} },
              { "speaker": "shadow", "text": {"es": "No me decepciones.", "en": "Don't disappoint me."} }
            ]
          },
          {
            "id": "end_interested",
            "condition": "goodInteraction",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Entiendes la discreción.", "en": "You understand discretion."} },
              { "speaker": "shadow", "text": {"es": "Cualidad rara.", "en": "Rare quality."} },
              { "speaker": "shadow", "text": {"es": "Hablaremos de nuevo.", "en": "We'll talk again."} }
            ]
          }
        ]
      }
    },
    "level2": {
      "intro": {
        "variants": [
          {
            "id": "intro_verified",
            "condition": "default",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Verificado.", "en": "Verified."} },
              { "speaker": "shadow", "text": {"es": "Te mantuviste callado. Bien.", "en": "You kept quiet. Good."} },
              { "speaker": "shadow", "text": {"es": "Hora de hablar de lo que puedo hacer realmente.", "en": "Time to discuss what I can actually do."} }
            ]
          }
        ]
      },
      "nudo": {
        "branches": {
          "nudo_capabilities": [
            { "speaker": "shadow", "text": {"es": "Puedo rastrear cualquier pieza.", "en": "I can trace any part."} },
            { "speaker": "shadow", "text": {"es": "Números de serie. Dueños previos. Modificaciones.", "en": "Serial numbers. Previous owners. Modifications."} },
            { "speaker": "shadow", "text": {"es": "Registros de seguros. Informes policiales. Historiales de subastas.", "en": "Insurance records. Police reports. Auction histories."} },
            { "speaker": "shadow", "text": {"es": "Todo deja un rastro.", "en": "Everything leaves a trail."} },
            { "speaker": "shadow", "text": {"es": "La mayoría no lo ve. Yo sí.", "en": "Most people can't see it. I can."} }
          ],
          "nudo_origin": [
            { "speaker": "shadow", "text": {"es": "Empecé joven. Ordenadores.", "en": "Started young. Computers."} },
            { "speaker": "shadow", "text": {"es": "Solía ayudar a un amigo con proyectos técnicos.", "en": "Used to help a friend with tech projects."} },
            { "speaker": "shadow", "text": {"es": "Tío listo. Hardware sobre todo. ECUs y cajas de tuning.", "en": "Smart guy. Hardware mostly. ECUs and tuning boxes."} },
            { "speaker": "shadow", "text": {"es": "Yo manejaba el software. Investigación.", "en": "I handled the software side. Research."} },
            { "speaker": "shadow", "text": {"es": "Nos distanciamos. Métodos diferentes. Mismos objetivos.", "en": "We grew apart. Different methods. Same goals."} },
            { "speaker": "shadow", "text": {"es": "Él sigue construyendo. Yo sigo buscando. A veces nuestros caminos se cruzan.", "en": "He still builds. I still search. Sometimes our paths cross."} }
          ],
          "nudo_warning": [
            { "speaker": "shadow", "text": {"es": "Una advertencia.", "en": "A warning."} },
            { "speaker": "shadow", "text": {"es": "Lo que hago no es legal. No técnicamente.", "en": "What I do isn't legal. Not technically."} },
            { "speaker": "shadow", "text": {"es": "Usas mis servicios. Aceptas el riesgo.", "en": "You use my services. You accept the risk."} },
            { "speaker": "shadow", "text": {"es": "Protejo mis fuentes. Siempre.", "en": "I protect my sources. Always."} },
            { "speaker": "shadow", "text": {"es": "No puedo decir lo mismo de los clientes.", "en": "Can't say the same for clients."} }
          ]
        },
        "randomEvents": {
          "chance": 0.2,
          "events": [
            {
              "id": "hot_info",
              "text": {"es": "Datos interesantes cruzaron mi pantalla. Lote de piezas. Origen cuestionable.", "en": "Interesting data crossed my screen. A batch of parts. Questionable origin."},
              "responses": [
                { "id": "a", "text": {"es": "¿Robadas?", "en": "Stolen?"}, "traits": ["direct"], "points": 5 },
                { "id": "b", "text": {"es": "Me interesa. ¿Qué puedes decirme?", "en": "I'm interested. What can you tell me?"}, "traits": ["business"], "points": 10 },
                { "id": "c", "text": {"es": "No me importa a menos que me afecte.", "en": "Not my concern unless it affects me."}, "traits": ["careful"], "points": 15 }
              ]
            },
            {
              "id": "competitor",
              "text": {"es": "Alguien más hace trabajo similar. Chapucero. Dejando rastros.", "en": "Someone else is doing similar work. Sloppy. Leaving traces."},
              "responses": [
                { "id": "a", "text": {"es": "¿Competencia?", "en": "Competition?"}, "traits": ["curious"], "points": 5 },
                { "id": "b", "text": {"es": "Su problema. No nuestro.", "en": "Their problem. Not ours."}, "traits": ["detached"], "points": 15 },
                { "id": "c", "text": {"es": "Sería útil saber quién.", "en": "Could be useful to know who."}, "traits": ["strategic"], "points": 10 }
              ]
            }
          ]
        }
      },
      "desenlace": {
        "variants": [
          {
            "id": "end_business",
            "condition": "default",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Suficiente charla.", "en": "Enough talk."} },
              { "speaker": "shadow", "text": {"es": "Sabes lo que ofrezco.", "en": "You know what I offer."} },
              { "speaker": "shadow", "text": {"es": "Contacta cuando necesites encontrar algo.", "en": "Reach out when you need something found."} }
            ]
          }
        ]
      }
    },
    "level3": {
      "intro": {
        "variants": [
          {
            "id": "intro_trusted",
            "condition": "default",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Estado de confianza.", "en": "Trusted status."} },
              { "speaker": "shadow", "text": {"es": "Te has ganado mi respeto.", "en": "You've proven yourself."} },
              { "speaker": "shadow", "text": {"es": "Hora de acceso más profundo.", "en": "Time for deeper access."} }
            ]
          }
        ]
      },
      "nudo": {
        "branches": {
          "nudo_network": [
            { "speaker": "shadow", "text": {"es": "La red es más grande de lo que piensas.", "en": "The network is larger than you think."} },
            { "speaker": "shadow", "text": {"es": "Mecánicos. Importadores. Coleccionistas. Corredores.", "en": "Mechanics. Importers. Collectors. Racers."} },
            { "speaker": "shadow", "text": {"es": "Todos conectados. La información fluye entre ellos.", "en": "All connected. Information flows between them."} },
            { "speaker": "shadow", "text": {"es": "Yo en el medio. Veo todo.", "en": "I sit in the middle. See everything."} },
            { "speaker": "shadow", "text": {"es": "Conocimiento es poder. Literalmente.", "en": "Knowledge is power. Literally."} }
          ],
          "nudo_past": [
            { "speaker": "shadow", "text": {"es": "Quieres saber sobre mí.", "en": "You want to know about me."} },
            { "speaker": "shadow", "text": {"es": "Todos lo hacen eventualmente.", "en": "Everyone does eventually."} },
            { "speaker": "shadow", "text": {"es": "Fui otra persona una vez. Nombre diferente. Vida diferente.", "en": "I was someone else once. Different name. Different life."} },
            { "speaker": "shadow", "text": {"es": "Cometí errores. Confié en la gente equivocada.", "en": "Made mistakes. Trusted wrong people."} },
            { "speaker": "shadow", "text": {"es": "Ahora confío en datos. Los números no mienten.", "en": "Now I trust data. Numbers don't lie."} },
            { "speaker": "shadow", "text": {"es": "Las personas siempre lo hacen.", "en": "People always do."} }
          ],
          "nudo_connections": [
            { "speaker": "shadow", "text": {"es": "Hay un importador con el que trabajo a veces.", "en": "There's an importer I work with sometimes."} },
            { "speaker": "shadow", "text": {"es": "Especialista JDM. Obsesionado con la autenticidad.", "en": "JDM specialist. Obsessed with authenticity."} },
            { "speaker": "shadow", "text": {"es": "Verifico la procedencia de sus piezas raras.", "en": "I verify provenance for his rare pieces."} },
            { "speaker": "shadow", "text": {"es": "Él conoce sus piezas. Yo conozco sus historias.", "en": "He knows his parts. I know their histories."} },
            { "speaker": "shadow", "text": {"es": "Buena asociación. Sin preguntas. Solo resultados.", "en": "Good partnership. No questions. Just results."} }
          ]
        },
        "randomEvents": {
          "chance": 0.2,
          "events": [
            {
              "id": "legend",
              "text": {"es": "Oí algo interesante. Corredor viejo. Mujer. De los primeros días.", "en": "Heard something interesting. Old racer. Woman. From the early days."},
              "responses": [
                { "id": "a", "text": {"es": "¿Sigue activa?", "en": "Still active?"}, "traits": ["curious"], "points": 5 },
                { "id": "b", "text": {"es": "Quien dura tanto sabe lo que hace.", "en": "Those who lasted that long know what they're doing."}, "traits": ["respectful"], "points": 15 },
                { "id": "c", "text": {"es": "¿Cuál es su historia?", "en": "What's her story?"}, "traits": ["interested"], "points": 10 }
              ]
            }
          ]
        }
      },
      "desenlace": {
        "variants": [
          {
            "id": "end_deep",
            "condition": "default",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Estás metido hasta el fondo ahora.", "en": "You're in deep now."} },
              { "speaker": "shadow", "text": {"es": "No hay vuelta atrás.", "en": "No going back."} },
              { "speaker": "shadow", "text": {"es": "Recuerda las reglas. Siempre.", "en": "Remember the rules. Always."} }
            ]
          }
        ]
      }
    },
    "level4": {
      "intro": {
        "variants": [
          {
            "id": "intro_ghost",
            "condition": "default",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Ghost Protocol.", "en": "Ghost protocol."} },
              { "speaker": "shadow", "text": {"es": "Acceso total.", "en": "Full access."} },
              { "speaker": "shadow", "text": {"es": "Sin límites.", "en": "No limits."} }
            ]
          }
        ]
      },
      "nudo": {
        "branches": {
          "nudo_truth": [
            { "speaker": "shadow", "text": {"es": "Quieres la verdad.", "en": "You want the truth."} },
            { "speaker": "shadow", "text": {"es": "Llevo haciendo esto quince años.", "en": "I've been doing this for fifteen years."} },
            { "speaker": "shadow", "text": {"es": "Empezó como hobby. Se volvió profesión.", "en": "Started as a hobby. Became a profession."} },
            { "speaker": "shadow", "text": {"es": "Ahora es todo lo que sé.", "en": "Now it's all I know."} },
            { "speaker": "shadow", "text": {"es": "Las sombras se volvieron hogar.", "en": "The shadows became home."} }
          ],
          "nudo_final": [
            { "speaker": "shadow", "text": {"es": "En este nivel...", "en": "At this level..."} },
            { "speaker": "shadow", "text": {"es": "Puedo encontrar cualquier cosa. Cualquiera.", "en": "I can find anything. Anyone."} },
            { "speaker": "shadow", "text": {"es": "Registros que no existen. Gente que desapareció.", "en": "Records that don't exist. People who disappeared."} },
            { "speaker": "shadow", "text": {"es": "Usa esto con cuidado.", "en": "Use this carefully."} },
            { "speaker": "shadow", "text": {"es": "Algunas puertas no deberían abrirse.", "en": "Some doors shouldn't be opened."} }
          ]
        }
      },
      "desenlace": {
        "variants": [
          {
            "id": "end_final",
            "condition": "default",
            "exchanges": [
              { "speaker": "shadow", "text": {"es": "Hemos llegado al final.", "en": "We've reached the end."} },
              { "speaker": "shadow", "text": {"es": "O el principio. Depende de cómo lo veas.", "en": "Or the beginning. Depends how you see it."} },
              { "speaker": "shadow", "text": {"es": "Tienes acceso a todo ahora.", "en": "You have access to everything now."} },
              { "speaker": "shadow", "text": {"es": "Lo que hagas con ello...", "en": "What you do with it..."} },
              { "speaker": "shadow", "text": {"es": "Es tu elección.", "en": "That's your choice."} }
            ]
          }
        ]
      }
    }
  },
  "nexos": {
    "transitionPhrases": {
      "toNudo": [
        {"es": "Pero.", "en": "But."},
        {"es": "Hay más.", "en": "There's more."},
        {"es": "Escucha.", "en": "Listen."},
        {"es": "El punto es.", "en": "Point is."}
      ],
      "toDesenlace": [
        {"es": "Suficiente.", "en": "Enough."},
        {"es": "Eso es todo.", "en": "That's all."},
        {"es": "Se acabó el tiempo.", "en": "Time's up."},
        {"es": "Conexión terminando.", "en": "Connection ending."}
      ],
      "topicChange": [
        {"es": "Tema diferente.", "en": "Different subject."},
        {"es": "Además.", "en": "Also."},
        {"es": "Otra cosa.", "en": "Something else."},
        {"es": "Cambio de tema.", "en": "Change of topic."}
      ]
    },
    "flowControl": {
      "minExchangesBeforeTransition": 2,
      "maxExchangesPerPhase": 6,
      "allowBranchMixing": false
    }
  },
  "contextReactions": {
    "recentPurchase": {
      "chance": 0.2,
      "responses": [
        {"es": "Vi tu transacción reciente. Limpia.", "en": "Saw your recent transaction. Clean."},
        {"es": "Adquiriste algo. Lo sé.", "en": "You acquired something. I know."},
        {"es": "Esa pieza que conseguiste. Historia interesante.", "en": "That part you got. Interesting history."}
      ]
    },
    "longAbsence": {
      "chance": 0.6,
      "responses": [
        {"es": "Te perdiste en la oscuridad.", "en": "You went dark."},
        {"es": "Pensé que habías desaparecido.", "en": "Thought you'd disappeared."},
        {"es": "De vuelta del vacío.", "en": "Back from the void."}
      ]
    },
    "frequentVisitor": {
      "chance": 0.2,
      "responses": [
        {"es": "Contacto frecuente. Ten cuidado.", "en": "Frequent contact. Be careful."},
        {"es": "Demasiadas conexiones. Se forman patrones.", "en": "Too many connections. Patterns form."},
        {"es": "Estás aquí a menudo. Anotado.", "en": "You're here often. Noted."}
      ]
    },
    "afterGoodDeal": {
      "chance": 0.3,
      "responses": [
        {"es": "La intel fue útil.", "en": "Intel proved useful."},
        {"es": "Buen resultado. Como esperaba.", "en": "Good outcome. As expected."},
        {"es": "Satisfecho. Se nota.", "en": "Satisfied. I can tell."}
      ]
    }
  },
  "memory": {
    "trackedEvents": [
      "informationRequests",
      "discretionShown",
      "rulesFollowed",
      "connectionsRevealed",
      "trustDemonstrated"
    ],
    "referenceProbability": 0.15,
    "referenceTemplates": {
      "search": {"es": "Esa búsqueda que pediste. Sobre {target}. Interesante.", "en": "That search you requested. About {target}. Interesting."},
      "discretion": {"es": "Te mantuviste callado sobre {topic}. Apreciado.", "en": "You kept quiet about {topic}. Appreciated."},
      "growth": {"es": "Has aprendido a operar en las sombras.", "en": "You've learned to operate in shadows."}
    }
  },
  "strikeSystem": {
    "maxStrikes": 2,
    "strikeActions": [
      "asking_personal_questions",
      "revealing_information",
      "mentioning_channel",
      "demanding_sources"
    ],
    "strikeResponses": [
      {"es": "Regla rota.", "en": "Rule broken."},
      {"es": "Te lo advertí.", "en": "Warned you."},
      {"es": "Strike registrado.", "en": "Strike recorded."}
    ],
    "banMessage": {"es": "Conexión terminada. Permanentemente.", "en": "Connection terminated. Permanently."}
  }
}
